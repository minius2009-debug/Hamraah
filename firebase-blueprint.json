{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["customer", "provider", "admin"] },
        "rating": { "type": "number" },
        "completedJobs": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "savedPlaces": {
          "type": "object",
          "properties": {
            "home": { "type": "string" },
            "work": { "type": "string" }
          }
        }
      },
      "required": ["id", "name", "email", "role"]
    },
    "ServiceRequest": {
      "title": "Service Request",
      "description": "A request for a service (hiring or transport)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "destination": { "type": "string" },
        "description": { "type": "string", "maxLength": 2000 },
        "initialOfferPKR": { "type": "number" },
        "assignedDriverId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "negotiating", "in_progress", "completed", "cancelled"] },
        "preferences": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "category", "location", "initialOfferPKR", "status"]
    },
    "CivicIssue": {
      "title": "Civic Issue",
      "description": "A community reported problem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string" },
        "upvotesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["posted", "escalated", "resolved"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "title", "description", "category", "status"]
    },
    "VerificationApplication": {
      "title": "Verification Application",
      "description": "Provider application for platform verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "skills": { "type": "array" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Public user profiles"
    },
    "service_requests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Broadcasting service requests"
    },
    "civic_issues/{issueId}": {
      "schema": "CivicIssue",
      "description": "Community advocacy issues"
    },
    "verification_applications/{applicationId}": {
      "schema": "VerificationApplication",
      "description": "Pending and past verification applications"
    }
  }
}
