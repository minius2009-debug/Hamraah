rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Auth tokens NEVER contain custom claims in rules.
    // Use get() on a trusted database document for roles.
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'minius2009@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'role', 'rating', 'completedJobs', 'isVerified', 'photoURL', 'createdAt', 'updatedAt', 'bio', 'experience', 'skills', 'referralCode', 'savedPlaces']) &&
             data.id == request.auth.uid;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['id', 'customerId', 'category', 'location', 'status']) &&
             data.customerId == request.auth.uid;
    }

    function isValidCivicIssue(data) {
      return data.keys().hasAll(['id', 'creatorId', 'title', 'description', 'category', 'status']) &&
             data.creatorId == request.auth.uid;
    }

    // Collection Matches
    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming())) || isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn();
        allow update: if isOwner(userId);
      }
    }

    match /service_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && isValidServiceRequest(incoming());
      allow update: if isSignedIn() && (
        isOwner(existing().customerId) || 
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedProviderId', 'finalPricePKR', 'updatedAt']))
      );

      match /negotiations/{negotiationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(negotiationId);
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId);
      }
    }

    match /civic_issues/{issueId} {
      allow read: if true; 
      allow create: if isSignedIn() && isValidId(issueId) && isValidCivicIssue(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'downvotesCount', 'commentsCount', 'updatedAt', 'aiMetadata']))
      );
      allow delete: if isAdmin();

      match /upvotes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }

      match /downvotes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId);
      }
    }
      
    match /verification_applications/{applicationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /chats/{chatId} {
       // Using a participants array in the document is better than splitting the ID
       allow read, create: if isSignedIn() && (request.auth.uid in resource.data.participants || request.auth.uid in incoming().participants);
       
       match /messages/{messageId} {
         allow read: if isSignedIn();
         allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
       }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
    }
  }
}
