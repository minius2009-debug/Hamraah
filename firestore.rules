rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    // Validation Helpers
    function isValidUser(data) {
      return data.id == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['customer', 'provider', 'admin'] &&
             data.rating is number &&
             data.completedJobs is number &&
             data.isVerified is bool &&
             data.keys().hasAll(['id', 'name', 'email', 'role', 'rating', 'completedJobs', 'isVerified']);
    }

    function isValidServiceRequest(data) {
      return data.id is string &&
             data.customerId == request.auth.uid &&
             data.category is string &&
             data.location is string &&
             data.initialOfferPKR is number &&
             data.status in ['pending', 'negotiating', 'in_progress', 'completed', 'cancelled'] &&
             data.keys().hasAll(['id', 'customerId', 'category', 'location', 'initialOfferPKR', 'status']);
    }

    function isValidCivicIssue(data) {
      return data.id is string &&
             data.creatorId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string &&
             data.status in ['posted', 'escalated', 'resolved'] &&
             data.keys().hasAll(['id', 'creatorId', 'title', 'description', 'category', 'status']);
    }

    // Collection Matches
    match /users/{userId} {
      allow read: if true; // Publicly readable for names/ratings
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['role', 'rating', 'completedJobs', 'bio', 'skills', 'savedPlaces', 'updatedAt']);

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn();
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      }
    }

    match /service_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && isValidServiceRequest(incoming());
      allow update: if isSignedIn() && (
        // Customer can update status or cancel
        (isOwner(existing().customerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedDriverId', 'updatedAt'])) ||
        // Provider can accept/update status if assigned
        (existing().assignedDriverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Broadcast accept
        (existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedDriverId', 'updatedAt']))
      );

      match /negotiations/{negotiationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(negotiationId);
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId);
      }
    }

    match /civic_issues/{issueId} {
      allow read: if true; // Public awareness
      allow create: if isSignedIn() && isValidId(issueId) && isValidCivicIssue(incoming());
      allow update: if isSignedIn() && (
        // Community upvotes
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'updatedAt'])) ||
        // Creator update
        (isOwner(existing().creatorId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'updatedAt']))
      );
      allow delete: if isAdmin();

      match /upvotes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
    }

    match /verification_applications/{applicationId} {
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }
    
    // Subcollections
    match /civic_issues/{issueId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && incoming().userId == request.auth.uid;
    }
    
    match /chats/{chatId} {
       allow read: if isSignedIn() && (request.auth.uid in chatId.split('_'));
       allow create: if isSignedIn() && (request.auth.uid in chatId.split('_'));
       
       match /messages/{messageId} {
         allow read: if isSignedIn();
         allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
       }
    }
  }
}
